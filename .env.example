# Mode : "paper" (simulation, aucun fonds engagé) ou "live" (vraies transactions)
MODE=paper

# Wallet (live uniquement) : clé privée base58. Utiliser un wallet DÉDIÉ au bot, jamais le principal.
BS58_PRIVATE_KEY=

# RPC Solana (lecture des bonding curves). Le public est limité : prendre Helius/QuickNode pour tourner 24/7.
RPC_URL=

# Clés API optionnelles
JUPITER_API_KEY=
PUMPPORTAL_API_KEY=

# Taille d'une position et limites
BUY_SOL=0.05
MAX_OPEN_POSITIONS=3
MAX_EVALUATIONS=10          # tokens évalués en parallèle pendant le délai d'entrée

# Coûts fixes simulés par position (paper) : frais de transaction par tx et rent du compte de token
TX_COST_SOL=0.0002
ATA_RENT_SOL=0.00204

# Sorties (en % du coût complet)
TAKE_PROFIT_PCT=40
STOP_LOSS_PCT=25
TRAIL_ARM_PCT=10
TRAIL_PCT=15
MAX_HOLD_SECONDS=300
POLL_SECONDS=5

# Filtres immédiats sur l'événement de création
MIN_DEV_BUY_SOL=0.5
MAX_DEV_BUY_SOL=3
MAX_MCAP_SOL=45

# Moment d'achat (pump.fun) : momentum = après ENTRY_DELAY_SECONDS et les filtres lents ci-dessous ;
# creation = dès l'annonce, au prix de la curve à cet instant (paper seulement ; sans RugCheck ni Jupiter).
# Test du 17/11 : ENTRY_MODE=creation MIN_DEV_BUY_SOL=0 TAKE_PROFIT_PCT=200 STOP_LOSS_PCT=50
#   MAX_HOLD_SECONDS=7200 TRAIL_ARM_PCT=100000 MAX_OPEN_POSITIONS=10 PLATFORMS=pump.fun
ENTRY_MODE=momentum
# Filtres lents (voir docs/pumpfun-playbook.md : E1, E2, E5)
REQUIRE_TELEGRAM=true
ENTRY_DELAY_SECONDS=60
MIN_INFLOW_SOL=3

DB_PATH=bottofun.db

# Plateformes suivies. pump.fun arrive par PumpPortal ; les autres par la liste Jupiter des tokens récents.
PLATFORMS=pump.fun,letsbonk,raydium,meteora-dbc,moonshot
LAUNCH_POLL_SECONDS=10

# Suivi fantôme : mcap de chaque token pump.fun, acheté ou non, pour tester des règles sans trader (table shadow_prices).
SHADOW_HOURS=2              # durée max de suivi d'un token, 0 = désactivé
SHADOW_SECONDS=10           # une lecture groupée des curves (100 par appel RPC) toutes les N secondes

# Sécurité : chaque contrôle qui échoue (ou ne peut pas être fait) bloque l'achat.
# Toujours actifs : mint/freeze authority nulles, pas d'extension Token-2022 hors métadonnées, aucun risque « danger » RugCheck.
MAX_RUG_SCORE=20            # score RugCheck normalisé, 1 = sain, 100 = très risqué
MAX_TOP10_PCT=30            # % de la supply détenu par les 10 plus gros holders (hors bonding curve)
MAX_HOLDER_PCT=10
MAX_INSIDER_PCT=10          # wallets liés détectés par RugCheck
MIN_LP_LOCKED_PCT=100       # % de la liquidité de chaque pool verrouillée ou brûlée (RugCheck)
MAX_CREATOR_LAUNCHES_24H=3  # créateur qui lance en série
MIN_LIQUIDITY_SOL=4         # SOL réels dans la curve
MAX_ROUNDTRIP_LOSS_PCT=6    # simulation achat + revente via Jupiter (~3 % normal)
RUG_LOSS_PCT=50             # une perte >= ce % met le créateur sur liste noire

# Tableau de bord temps réel (0 = désactivé). 127.0.0.1 : accessible seulement depuis la machine.
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# Bot Telegram : notifications et commandes depuis le mobile (vide = désactivé).
# 1. Crée le bot avec @BotFather (/newbot) et colle son token ici.
# 2. Démarre Brigitte, envoie /start au bot : il répond ton chat id. Colle-le ci-dessous et redémarre.
# Seul ce chat peut piloter Brigitte. Ne partage jamais le token : il donne le contrôle du bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
