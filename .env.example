# Mode : "paper" (simulation, aucun fonds engagé) ou "live" (vraies transactions)
MODE=paper

# Wallet (live uniquement) : clé privée base58. Utiliser un wallet DÉDIÉ au bot, jamais le principal.
BS58_PRIVATE_KEY=

# RPC Solana (lecture des bonding curves). Le public est limité : prendre Helius/QuickNode pour tourner 24/7.
RPC_URL=

# Clés API optionnelles
JUPITER_API_KEY=
PUMPPORTAL_API_KEY=

# Taille d'une position et limites
BUY_SOL=0.05
MAX_OPEN_POSITIONS=3

# Coûts fixes simulés par position (paper) : frais de transaction par tx et rent du compte de token
TX_COST_SOL=0.0002
ATA_RENT_SOL=0.00204

# Sorties (en % du coût complet)
TAKE_PROFIT_PCT=40
STOP_LOSS_PCT=25
TRAIL_ARM_PCT=10
TRAIL_PCT=15
MAX_HOLD_SECONDS=300
POLL_SECONDS=5

# Filtres immédiats sur l'événement de création
MIN_DEV_BUY_SOL=0.5
MAX_DEV_BUY_SOL=3
MAX_MCAP_SOL=45

# Filtres lents (voir docs/pumpfun-playbook.md : E1, E2, E5)
REQUIRE_TELEGRAM=true
ENTRY_DELAY_SECONDS=60
MIN_INFLOW_SOL=3

DB_PATH=bottofun.db
